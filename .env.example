DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=paredescano_app
DB_PASSWORD=
DB_NAME=paredescano
TZ=America/Lima
HOSTNAME=0.0.0.0
PORT=3000
VITE_API_BASE_URL=
WIDGET_SYNC_ENABLED=false

# Codigo de instalacion de /api/setup/admin y /api/setup/empresa.
# Obligatorio en produccion: las peticiones deben enviarlo en la cabecera
# X-Setup-Token. Si no esta definido en produccion, esos endpoints responden 404.
# En desarrollo se puede dejar vacio para usar el flujo local sin el secreto.
SETUP_TOKEN=
