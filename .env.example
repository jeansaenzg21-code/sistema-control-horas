# ============================================================
# Plantilla de variables de entorno.
#
# Para Docker: copiar a .env y completar valores reales.
#   cp .env.example .env
#   chmod 600 .env
#
# .env esta ignorado por git. NUNCA versionar credenciales reales ni pasar
# secretos como build args: se inyectan en tiempo de ejecucion.
# ============================================================

# ---------- Aplicacion ----------
# Dentro del contenedor la app escucha en 0.0.0.0:3000 (no cambiar).
HOSTNAME=0.0.0.0
PORT=3000
TZ=America/Lima
LOG_LEVEL=info

# ---------- Docker Compose (solo despliegue) ----------
# Direccion del host donde se publica el puerto del contenedor.
# 127.0.0.1 => solo Nginx (instalado en el host) puede acceder. Recomendado.
# 0.0.0.0   => expone el puerto a la red (no recomendado sin firewall).
APP_BIND_ADDR=127.0.0.1
APP_PORT=3000
# Nombre/tag de la imagen. Versionar con commit o fecha, por ejemplo:
#   APP_IMAGE=sistema-control-horas:2026-11-15-a607697
APP_IMAGE=sistema-control-horas:latest

# ---------- Base de datos MySQL (externa al contenedor) ----------
# IMPORTANTE: dentro del contenedor "localhost" y "127.0.0.1" apuntan AL
# CONTENEDOR, no al host. Usar:
#   DB_HOST=host.docker.internal   -> MySQL instalado en el host
#   DB_HOST=10.0.0.15              -> MySQL en otro servidor (IP o hostname)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=paredescano_app
DB_PASSWORD=
DB_NAME=paredescano

# Pool de conexiones (opcional; los valores mostrados son los defaults).
# DB_POOL_MAX=10
# DB_POOL_COLA=60
# DB_POOL_CONNECT_TIMEOUT_MS=8000
# DB_POOL_MAX_IDLE=10
# DB_POOL_IDLE_TIMEOUT_MS=60000

# ---------- Seguridad / sesiones ----------
# Las cookies de sesion llevan HttpOnly + SameSite=Lax y, en produccion,
# Secure de forma automatica (lib/auth.ts). Esto exige HTTPS en el proxy.
# COOKIE_SECURE=true fuerza Secure tambien fuera de produccion. NO desactivar
# en produccion: sin Secure la sesion puede viajar en texto plano.
COOKIE_SECURE=true

# Codigo de instalacion de /api/setup/admin y /api/setup/empresa.
# En produccion, si queda vacio esos endpoints responden 404 (no existen).
# Definir uno largo y aleatorio solo durante la instalacion; luego rotarlo o
# retirarlo. Generar con: openssl rand -hex 32
SETUP_TOKEN=

# ---------- Integraciones opcionales ----------
# Widget de escritorio (sincronizacion). Deshabilitado por defecto en prod.
WIDGET_SYNC_ENABLED=false
# Origenes CORS adicionales para la app movil, separados por coma.
ORIGENES_MOVIL=
# URL base usada al compilar el widget (Tauri); no afecta al servidor web.
VITE_API_BASE_URL=

# ============================================================
# Pruebas locales (docker-compose.test.yml). Credenciales FICTICIAS.
# No se usan en produccion.
# ============================================================
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=test_app
TEST_DB_PASSWORD=test_app_password
TEST_DB_NAME=paredescano_test
